{
    "name": "@sinthra/root",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": ">=24.22.3"
    },
    "scripts": {
        "dev": "pnpm --recursive --parallel run dev",
        "dev:worker": "uv run --project apps/worker --env-file .env python -m sinthra_worker",
        "lint": "eslint . && pnpm run lint:worker",
        "lint:worker": "uv run --directory apps/worker ruff check",
        "format": "prettier --write . && pnpm run format:worker",
        "format:worker": "uv run --directory apps/worker ruff format",
        "format:check": "prettier --check . && pnpm run format:check:worker",
        "format:check:worker": "uv run --directory apps/worker ruff format --check",
        "typecheck": "pnpm --recursive run typecheck && pnpm run typecheck:worker",
        "typecheck:worker": "uv run --directory apps/worker mypy",
        "test": "pnpm --recursive run test && pnpm run test:worker",
        "test:worker": "uv run --directory apps/worker pytest",
        "prepare": "lefthook install"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "lefthook": "^2.2.2",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.74.0"
    }
}
