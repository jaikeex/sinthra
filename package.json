{
    "name": "@sinthra/root",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": ">=24.22.3"
    },
    "scripts": {
        "dev": "pnpm --recursive --parallel run dev",
        "db:up": "docker compose --project-directory . --file infra/compose.yaml up --detach --wait",
        "db:down": "docker compose --project-directory . --file infra/compose.yaml down",
        "stack:up": "node scripts/stack-up.js",
        "stack:smoke": "node --env-file=.env scripts/stack-smoke.js",
        "stack:down": "docker compose --project-directory . --file infra/compose.yaml --profile stack down",
        "dev:worker": "uv run --project apps/worker --env-file .env python -m sinthra_worker",
        "lint": "pnpm run lint:ts && pnpm run lint:worker",
        "lint:ts": "eslint .",
        "lint:worker": "uv run --directory apps/worker ruff check",
        "format": "pnpm run format:ts && pnpm run format:worker",
        "format:ts": "prettier --write .",
        "format:worker": "uv run --directory apps/worker ruff format",
        "format:check": "pnpm run format:check:ts && pnpm run format:check:worker",
        "format:check:ts": "prettier --check .",
        "format:check:worker": "uv run --directory apps/worker ruff format --check",
        "typecheck": "pnpm run typecheck:ts && pnpm run typecheck:worker",
        "typecheck:ts": "pnpm --recursive run typecheck",
        "typecheck:worker": "uv run --directory apps/worker mypy",
        "test": "pnpm run test:ts && pnpm run test:worker",
        "test:ts": "pnpm --recursive run test",
        "test:worker": "uv run --directory apps/worker pytest",
        "build": "pnpm --recursive run build",
        "prepare": "lefthook install"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "lefthook": "^2.2.2",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.74.0"
    }
}
