{
    "name": "@sinthra/root",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": ">=24.22.3"
    },
    "scripts": {
        "dev": "pnpm --recursive --parallel run dev",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "pnpm --recursive run typecheck",
        "test": "pnpm --recursive run test",
        "prepare": "lefthook install"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "lefthook": "^2.2.2",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.74.0"
    }
}
